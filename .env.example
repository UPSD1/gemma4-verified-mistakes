# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Load into your shell with:  set -a; source .env; set +a

# ---- Kaggle: competition data and models ----
# kaggle.com/settings -> API -> Create New Token (accept the competition rules first)
KAGGLE_API_TOKEN=

# ---- Hugging Face: Gemma 4 weights ----
# huggingface.co/settings/tokens
HF_TOKEN=

# Gemma 4 checkpoint path or HF id used by runpod/setup.sh
MODEL=

# ---- RunPod pod ----
# Large data (FreshSWE-Py, OOD-45 snapshots, competition data, models, run results) stays
# on the pod; runpod/rp.sh reads these settings to run commands there and copy files.
#   runpod/rp.sh ssh | run "<cmd>" | pull <remote> <local> | push <local> <remote> | tunnel
#
# Connection. From the pod page: Connect -> "SSH over exposed TCP". Host and port change
# when the pod restarts; the proxy address is the fallback ("Basic SSH" on the same page).
RUNPOD_POD_ID=
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY=$HOME/.ssh/id_ed25519
RUNPOD_SSH_PROXY=

# Paths on the pod
RUNPOD_WORKSPACE=/workspace
RUNPOD_ENV_SCRIPT=/workspace/env.sh             # source first: venv + HF/Kaggle tokens
RUNPOD_REPO_DIR=/workspace/repo                 # our code + data/tasks (184 mined, 647 FreshSWE, grpc/)
RUNPOD_COMP_DIR=/workspace/comp                 # competition data: 129 public tasks, snapshots, wheels
RUNPOD_FRESHSWE_DIR=/workspace/datasets/freshswe  # FreshSWE-Py full (tasks.jsonl, snapshots, wheelhouse)
RUNPOD_OOD45_DIR=/workspace/datasets/ood45      # OOD-45 full (tasks.jsonl, snapshots, wheels)
RUNPOD_MODELS_DIR=/workspace/models             # kaggle-12b (served), QAT bf16 weights (LoRA)
RUNPOD_RESULTS_DIR=/workspace/results           # harness runs: <run>/task_results.jsonl
RUNPOD_LOGS_DIR=/workspace/logs
RUNPOD_GRPC_WHEELS_DIR=/workspace/wheels_grpc   # grpcio, pytest-asyncio, mock for the gRPC slice

# vLLM on the pod (started by /workspace/serve.sh). "runpod/rp.sh tunnel" makes it
# reachable here at http://localhost:$RUNPOD_VLLM_LOCAL_PORT/v1
RUNPOD_VLLM_PORT=8000
RUNPOD_VLLM_LOCAL_PORT=8000
RUNPOD_VLLM_MODEL=gemma-4-12b-it-qat-w4a16-ct

# Optional: RunPod API key, to start/stop the pod from scripts (runpod.io -> Settings -> API Keys)
RUNPOD_API_KEY=

# ---- Model provider API keys (fairness screen) ----
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# platform.openai.com -> API keys
OPENAI_API_KEY=

# ---- Fairness screen raters (verify/fairness_screen.py --rater OPUS | SOL) ----
# Keys come from the provider keys above. Prices: USD per 1M tokens, checked Nov 10 2026.
# MAX_COST: the run stops starting new tasks once spend reaches this (USD).

# Rater 1: Claude Opus 5.5 (Anthropic) -> uses ANTHROPIC_API_KEY
OPUS_BASE_URL=https://api.anthropic.com/v1
OPUS_MODEL=claude-opus-5-5
OPUS_PRICE_IN=4
OPUS_PRICE_OUT=20
OPUS_MAX_COST=5

# Rater 2: gpt-6.1-sol (OpenAI) -> uses OPENAI_API_KEY
SOL_BASE_URL=https://api.openai.com/v1
SOL_MODEL=gpt-6.1-sol
SOL_PRICE_IN=2
SOL_PRICE_OUT=10
SOL_MAX_COST=5
# Reasoning models only: low | medium | high. Remove if OpenAI says the model doesn't support it.
SOL_REASONING_EFFORT=low

# ---- Training pod (H100, LoRA training; see runpod/train_pod/README.md) ----
# From the pod page: Connect -> "SSH over exposed TCP". Host and port change when it restarts.
TRAIN_SSH_HOST=
TRAIN_SSH_PORT=
TRAIN_SSH_USER=root
TRAIN_SSH_KEY=$HOME/.ssh/id_ed25519
