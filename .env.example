# Copy to .env and fill in. .env is gitignored; never commit real tokens.
# Load into your shell with:  set -a; source .env; set +a

# Kaggle: kaggle.com/settings -> API -> Create New Token (accept the competition rules first)
KAGGLE_API_TOKEN=

# Hugging Face, for downloading Gemma 4 weights: huggingface.co/settings/tokens
HF_TOKEN=

# Gemma 4 checkpoint path or HF id used by runpod/setup.sh
MODEL=
